  "blocks": {
    "paragraph": "One short purpose statement, semantic H1/H2/H3, each full sentence on its own line.",
    "table": "Compact comparison or register, meaningful columns, descriptive links, no giant prose cells.",
    "hint": "One short source/scope/decision notice; do not repeat it on every page.",
    "stepper": "Native GitBook ordered procedure, prerequisites and observable result; numbered-list fallback if unsupported.",
    "code": "Language-tagged code, safe placeholders, validated against approved contract; never secrets.",
    "mermaid-context": "C4 System Context semantics in supported flowchart syntax, labeled boundaries and arrows.",
    "mermaid-container": "C4 Container semantics; components only inside a named container.",
    "mermaid-sequence": "Supported sequenceDiagram syntax; split happy and failure paths.",
    "mermaid-deployment": "Environment-specific deployment nodes, never infer production from local config.",
    "openapi-operations": "Organization OpenAPI spec rendered by builtin:openapi computed page; preserve template props.",
    "openapi-models": "Schemas generated from the same canonical OpenAPI specification.",
    "download-link": "Computed OpenAPI downloadLink property, no manually fabricated URL.",
    "checklist": "Verification with observable acceptance evidence.",
    "numbered-list": "Ordered actionable steps.",
    "list": "Parallel concise change items.",
    "tabs": "Alternative environments or languages, never hide required sequential steps."
  }
